{
  "entities": {
    "User": {
      "title": "User",
      "description": "Authenticated platform user with role-based access control.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "photoUrl": { "type": "string", "maxLength": 500 },
        "role": { "type": "string", "enum": ["Super Admin", "IT Admin", "HR Admin", "Department Manager", "Employee"] },
        "employeeId": { "type": "string", "maxLength": 128 },
        "department": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "role"]
    },
    "Employee": {
      "title": "Employee",
      "description": "Corporate employee record for asset custody and offboarding clearance.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "employeeCode": { "type": "string", "minLength": 2, "maxLength": 40, "pattern": "^[A-Z0-9\\-]+$" },
        "fullName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "photoUrl": { "type": "string", "maxLength": 500 },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 40 },
        "department": { "type": "string", "minLength": 1, "maxLength": 100 },
        "designation": { "type": "string", "minLength": 1, "maxLength": 120 },
        "reportingManager": { "type": "string", "maxLength": 120 },
        "joiningDate": { "type": "string", "maxLength": 30 },
        "employmentStatus": { "type": "string", "enum": ["Active", "On Leave", "Resigned", "Terminated"] },
        "location": { "type": "string", "minLength": 1, "maxLength": 120 },
        "clearanceStatus": { "type": "string", "enum": ["Not Applicable", "Pending", "Complete"] }
      },
      "required": ["id", "employeeCode", "fullName", "email", "department", "designation", "joiningDate", "employmentStatus", "location"]
    },
    "Asset": {
      "title": "Asset",
      "description": "Physical company asset tracked across its full lifecycle.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "assetCode": { "type": "string", "minLength": 3, "maxLength": 40, "pattern": "^[A-Z0-9\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "category": { "type": "string", "enum": ["Laptop", "Desktop", "Monitor", "Keyboard", "Mouse", "Mobile Phone", "Tablet", "Headphones", "Charger / Adapter", "Networking Equipment", "Printer", "Office Furniture", "Other Equipment"] },
        "brand": { "type": "string", "minLength": 1, "maxLength": 80 },
        "model": { "type": "string", "minLength": 1, "maxLength": 100 },
        "serialNumber": { "type": "string", "minLength": 2, "maxLength": 100 },
        "imei": { "type": "string", "maxLength": 40 },
        "purchaseDate": { "type": "string", "maxLength": 30 },
        "purchaseCost": { "type": "number" },
        "vendorName": { "type": "string", "maxLength": 120 },
        "warrantyStartDate": { "type": "string", "maxLength": 30 },
        "warrantyExpiryDate": { "type": "string", "maxLength": 30 },
        "invoiceNumber": { "type": "string", "maxLength": 80 },
        "location": { "type": "string", "minLength": 1, "maxLength": 120 },
        "condition": { "type": "string", "enum": ["New", "Good", "Fair", "Poor", "Damaged"] },
        "status": { "type": "string", "enum": ["Purchased", "Available", "Assigned", "Under Maintenance", "Damaged", "Lost", "Retired", "Disposed"] },
        "assignedEmployeeId": { "type": "string", "maxLength": 128 },
        "assignedEmployeeName": { "type": "string", "maxLength": 120 },
        "notes": { "type": "string", "maxLength": 1000 },
        "imageUrl": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "assetCode", "name", "category", "brand", "model", "serialNumber", "purchaseDate", "purchaseCost", "location", "condition", "status"]
    },
    "AssetAssignment": {
      "title": "AssetAssignment",
      "description": "Historical and active issuance records linking an asset to an employee.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "assetId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "assetCode": { "type": "string", "minLength": 1, "maxLength": 40 },
        "assetName": { "type": "string", "minLength": 1, "maxLength": 160 },
        "employeeId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "employeeName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "employeeEmail": { "type": "string", "maxLength": 200 },
        "department": { "type": "string", "maxLength": 100 },
        "issueDate": { "type": "string", "maxLength": 30 },
        "expectedReturnDate": { "type": "string", "maxLength": 30 },
        "returnDate": { "type": "string", "maxLength": 30 },
        "conditionAtIssue": { "type": "string", "enum": ["New", "Good", "Fair", "Poor", "Damaged"] },
        "accessoriesIncluded": { "type": "string", "maxLength": 500 },
        "remarks": { "type": "string", "maxLength": 1000 },
        "acknowledgedByEmployee": { "type": "boolean" },
        "acknowledgedAt": { "type": "string", "maxLength": 40 },
        "receiptNumber": { "type": "string", "maxLength": 60 },
        "status": { "type": "string", "enum": ["Active", "Returned"] },
        "issuedByUid": { "type": "string", "maxLength": 128 },
        "issuedByName": { "type": "string", "maxLength": 120 }
      },
      "required": ["id", "assetId", "assetCode", "assetName", "employeeId", "employeeName", "issueDate", "conditionAtIssue", "status", "receiptNumber", "issuedByUid"]
    },
    "AssetReturn": {
      "title": "AssetReturn",
      "description": "Immutable return log capturing condition, damages, and next asset state.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "assignmentId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "assetId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "assetCode": { "type": "string", "maxLength": 40 },
        "assetName": { "type": "string", "maxLength": 160 },
        "employeeId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "employeeName": { "type": "string", "maxLength": 120 },
        "returnDate": { "type": "string", "maxLength": 30 },
        "conditionAtReturn": { "type": "string", "enum": ["New", "Good", "Fair", "Poor", "Damaged"] },
        "damageDetails": { "type": "string", "maxLength": 1000 },
        "missingAccessories": { "type": "string", "maxLength": 500 },
        "returnPhotoUrl": { "type": "string", "maxLength": 500 },
        "remarks": { "type": "string", "maxLength": 1000 },
        "nextAssetStatus": { "type": "string", "enum": ["Available", "Under Maintenance", "Damaged", "Retired"] },
        "processedByUid": { "type": "string", "maxLength": 128 },
        "processedByName": { "type": "string", "maxLength": 120 }
      },
      "required": ["id", "assignmentId", "assetId", "employeeId", "returnDate", "conditionAtReturn", "nextAssetStatus", "processedByUid"]
    },
    "AssetRequest": {
      "title": "AssetRequest",
      "description": "Employee hardware request traversing Manager and IT approvals.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "requesterUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "requesterEmployeeId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "requesterName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "department": { "type": "string", "minLength": 1, "maxLength": 100 },
        "category": { "type": "string", "minLength": 1, "maxLength": 80 },
        "justification": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "urgency": { "type": "string", "enum": ["Low", "Normal", "High", "Urgent"] },
        "status": { "type": "string", "enum": ["Requested", "Manager Approved", "IT Approved", "Assigned", "Rejected"] },
        "managerApprovedBy": { "type": "string", "maxLength": 120 },
        "itApprovedBy": { "type": "string", "maxLength": 120 },
        "rejectionReason": { "type": "string", "maxLength": 500 },
        "assignedAssetId": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "requesterUid", "requesterEmployeeId", "requesterName", "department", "category", "justification", "urgency", "status"]
    },
    "MaintenanceRecord": {
      "title": "MaintenanceRecord",
      "description": "Asset repair, vendor cost, and warranty service record.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "assetId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "assetCode": { "type": "string", "maxLength": 40 },
        "assetName": { "type": "string", "maxLength": 160 },
        "issueDescription": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "reportedDate": { "type": "string", "maxLength": 30 },
        "assignedTechnician": { "type": "string", "maxLength": 120 },
        "repairVendor": { "type": "string", "maxLength": 120 },
        "repairCost": { "type": "number" },
        "repairStatus": { "type": "string", "enum": ["Pending", "In Progress", "Completed", "Unrepairable"] },
        "resolutionDate": { "type": "string", "maxLength": 30 },
        "notes": { "type": "string", "maxLength": 1000 }
      },
      "required": ["id", "assetId", "issueDescription", "reportedDate", "repairStatus"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Append-only system audit entry for accountability.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "actorUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "actorName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "actorRole": { "type": "string", "maxLength": 60 },
        "action": { "type": "string", "minLength": 1, "maxLength": 100 },
        "entityType": { "type": "string", "minLength": 1, "maxLength": 60 },
        "entityId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
        "timestamp": { "type": "string", "maxLength": 40 }
      },
      "required": ["id", "actorUid", "actorName", "action", "entityType", "entityId", "summary", "timestamp"]
    },
    "Department": {
      "title": "Department",
      "description": "Organizational department entity.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "headName": { "type": "string", "maxLength": 120 },
        "costCenter": { "type": "string", "maxLength": 40 }
      },
      "required": ["id", "name"]
    },
    "Location": {
      "title": "Location",
      "description": "Physical office or warehouse location.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "city": { "type": "string", "maxLength": 80 },
        "country": { "type": "string", "maxLength": 80 }
      },
      "required": ["id", "name"]
    },
    "OrgPolicy": {
      "title": "OrgPolicy",
      "description": "Organization identity, domain restriction, and sign-in policy for Dextra.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "orgName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "orgSlug": { "type": "string", "minLength": 1, "maxLength": 60, "pattern": "^[a-z0-9\\-]+$" },
        "primaryDomain": { "type": "string", "minLength": 3, "maxLength": 120 },
        "allowedDomains": { "type": "array", "description": "Bounded list of allowed corporate email domains (max 10)." },
        "supportEmail": { "type": "string", "format": "email", "maxLength": 200 },
        "enforceDomainRestriction": { "type": "boolean" },
        "enableGoogleSso": { "type": "boolean" },
        "enableOrgEmailLogin": { "type": "boolean" },
        "enableLdapLogin": { "type": "boolean" },
        "defaultOnboardingRole": { "type": "string", "enum": ["Super Admin", "IT Admin", "HR Admin", "Department Manager", "Employee"] },
        "updatedByUid": { "type": "string", "maxLength": 128 },
        "updatedByName": { "type": "string", "maxLength": 120 },
        "updatedAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["id", "orgName", "orgSlug", "primaryDomain", "allowedDomains", "supportEmail", "enforceDomainRestriction", "enableGoogleSso", "enableOrgEmailLogin", "enableLdapLogin", "defaultOnboardingRole"]
    },
    "OrgIntegrations": {
      "title": "OrgIntegrations",
      "description": "Super-Admin-only SMTP mail relay and LDAP / Active Directory connection settings.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "smtpEnabled": { "type": "boolean" },
        "smtpHost": { "type": "string", "maxLength": 200 },
        "smtpPort": { "type": "number" },
        "smtpSecurity": { "type": "string", "enum": ["STARTTLS", "SSL/TLS", "None"] },
        "smtpFromName": { "type": "string", "maxLength": 120 },
        "smtpFromEmail": { "type": "string", "maxLength": 200 },
        "smtpUsername": { "type": "string", "maxLength": 200 },
        "smtpHasPassword": { "type": "boolean" },
        "notifyOnAssignment": { "type": "boolean" },
        "notifyOnReturn": { "type": "boolean" },
        "notifyOnWarrantyExpiry": { "type": "boolean" },
        "notifyOnOffboarding": { "type": "boolean" },
        "smtpLastTestedAt": { "type": "string", "maxLength": 40 },
        "smtpLastTestStatus": { "type": "string", "maxLength": 240 },
        "ldapEnabled": { "type": "boolean" },
        "ldapServerUrl": { "type": "string", "maxLength": 250 },
        "ldapPort": { "type": "number" },
        "ldapUseTls": { "type": "boolean" },
        "ldapBaseDn": { "type": "string", "maxLength": 250 },
        "ldapBindDn": { "type": "string", "maxLength": 250 },
        "ldapHasBindPassword": { "type": "boolean" },
        "ldapUserSearchFilter": { "type": "string", "maxLength": 250 },
        "ldapGroupSearchFilter": { "type": "string", "maxLength": 250 },
        "ldapAdminGroupDn": { "type": "string", "maxLength": 250 },
        "ldapItGroupDn": { "type": "string", "maxLength": 250 },
        "ldapHrGroupDn": { "type": "string", "maxLength": 250 },
        "ldapSyncIntervalHours": { "type": "number" },
        "ldapLastTestedAt": { "type": "string", "maxLength": 40 },
        "ldapLastTestStatus": { "type": "string", "maxLength": 240 },
        "updatedByUid": { "type": "string", "maxLength": 128 },
        "updatedByName": { "type": "string", "maxLength": 120 },
        "updatedAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["id", "smtpEnabled", "smtpHost", "smtpPort", "smtpSecurity", "smtpFromName", "smtpFromEmail", "smtpUsername", "smtpHasPassword", "notifyOnAssignment", "notifyOnReturn", "notifyOnWarrantyExpiry", "notifyOnOffboarding", "ldapEnabled", "ldapServerUrl", "ldapPort", "ldapUseTls", "ldapBaseDn", "ldapBindDn", "ldapHasBindPassword", "ldapUserSearchFilter", "ldapSyncIntervalHours"]
    },
    "OrgSecrets": {
      "title": "OrgSecrets",
      "description": "Strictly Super-Admin-isolated credentials for SMTP authentication and LDAP directory binding.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "smtpPassword": { "type": "string", "maxLength": 256 },
        "ldapBindPassword": { "type": "string", "maxLength": 256 },
        "updatedAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["id"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User accounts and role assignments"
    },
    "/employees/{employeeId}": {
      "schema": { "$ref": "#/entities/Employee" },
      "description": "Employee directory records"
    },
    "/assets/{assetId}": {
      "schema": { "$ref": "#/entities/Asset" },
      "description": "Centralized company asset inventory"
    },
    "/assetAssignments/{assignmentId}": {
      "schema": { "$ref": "#/entities/AssetAssignment" },
      "description": "Active and historical asset assignments"
    },
    "/assetReturns/{returnId}": {
      "schema": { "$ref": "#/entities/AssetReturn" },
      "description": "Immutable asset return records"
    },
    "/assetRequests/{requestId}": {
      "schema": { "$ref": "#/entities/AssetRequest" },
      "description": "Employee equipment requests and approval workflow"
    },
    "/maintenanceRecords/{recordId}": {
      "schema": { "$ref": "#/entities/MaintenanceRecord" },
      "description": "Asset maintenance and repair logs"
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Immutable audit trail of system actions"
    },
    "/departments/{departmentId}": {
      "schema": { "$ref": "#/entities/Department" },
      "description": "Corporate departments"
    },
    "/locations/{locationId}": {
      "schema": { "$ref": "#/entities/Location" },
      "description": "Office and storage locations"
    },
    "/orgPolicy/{policyId}": {
      "schema": { "$ref": "#/entities/OrgPolicy" },
      "description": "Organization branding, domain restriction, and sign-in policy"
    },
    "/orgIntegrations/{integrationId}": {
      "schema": { "$ref": "#/entities/OrgIntegrations" },
      "description": "Super-Admin-only SMTP and LDAP/Active Directory server settings"
    },
    "/orgSecrets/{secretId}": {
      "schema": { "$ref": "#/entities/OrgSecrets" },
      "description": "Super-Admin-only encrypted/protected SMTP and LDAP bind passwords"
    }
  }
}
